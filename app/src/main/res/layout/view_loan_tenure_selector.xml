<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardTenureContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="20dp"
    app:cardElevation="3dp"
    app:strokeColor="@color/border_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Top Header Row -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/txtTenureValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/txtInstallmentsCount"
                android:text="5 Years"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtInstallmentsCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="60 Installments"
                android:textColor="@color/primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Slider Row with Circular +/- Buttons -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/btnMinus"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_circle_button"
                android:clickable="true"
                android:focusable="true"
                android:padding="10dp"
                android:src="@drawable/ic_remove"
                android:translationZ="4dp"
                app:layout_constraintBottom_toBottomOf="@+id/sliderTenure"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/sliderTenure"
                app:tint="@color/text_primary" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderTenure"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:stepSize="1.0"
                android:value="60.0"
                android:valueFrom="12.0"
                android:valueTo="360.0"
                app:haloColor="#3B82F620"
                app:layout_constraintEnd_toStartOf="@+id/btnAdd"
                app:layout_constraintStart_toEndOf="@+id/btnMinus"
                app:layout_constraintTop_toTopOf="parent"
                app:thumbColor="@color/primary"
                app:trackColorActive="@color/primary"
                app:trackColorInactive="@color/border_stroke" />

            <ImageView
                android:id="@+id/btnAdd"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_circle_button"
                android:clickable="true"
                android:focusable="true"
                android:padding="10dp"
                android:src="@drawable/ic_add"
                android:translationZ="4dp"
                app:layout_constraintBottom_toBottomOf="@+id/sliderTenure"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/sliderTenure"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/txtMinRange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="1 Yr"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="@+id/sliderTenure"
                app:layout_constraintTop_toBottomOf="@+id/sliderTenure" />

            <TextView
                android:id="@+id/txtMaxRange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="30 Yrs"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="@+id/sliderTenure"
                app:layout_constraintTop_toBottomOf="@+id/sliderTenure" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 6 Quick Selection Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chip5Y"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="0dp"
                    android:text="5 Years"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    app:cornerRadius="18dp"
                    app:strokeColor="@color/border_stroke" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chip10Y"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="0dp"
                    android:text="10 Years"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    app:cornerRadius="18dp"
                    app:strokeColor="@color/border_stroke" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chip15Y"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="0dp"
                    android:text="15 Years"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    app:cornerRadius="18dp"
                    app:strokeColor="@color/border_stroke" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chip20Y"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="0dp"
                    android:text="20 Years"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    app:cornerRadius="18dp"
                    app:strokeColor="@color/border_stroke" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chip25Y"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="0dp"
                    android:text="25 Years"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    app:cornerRadius="18dp"
                    app:strokeColor="@color/border_stroke" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chip30Y"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="0dp"
                    android:text="30 Years"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    app:cornerRadius="18dp"
                    app:strokeColor="@color/border_stroke" />
            </LinearLayout>
        </HorizontalScrollView>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
